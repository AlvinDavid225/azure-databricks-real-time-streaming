# ============================================================
# P2 Live Fleet Operations Dashboard — Environment Config
# Copy this file to .env and fill in your actual values
# NEVER commit .env to Git
# ============================================================

# --- Azure Event Hub ---
EVENT_HUB_NAMESPACE=fleet-telemetry        # e.g. fleet-ops-eh-ns
EVENT_HUB_NAME=fleet-telemetry                      # Event Hub (topic) name
EVENT_HUB_CONNECTION_STRING=Endpoint=sb://your-namespace.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=YOUR_KEY_HERE       # Primary connection string from Azure Portal

# --- Azure Data Lake Storage Gen2 ---
ADLS_ACCOUNT_NAME=your_storage_account             # e.g. fleetopsdatalake
ADLS_ACCOUNT_KEY=your_storage_account_key          # From Access Keys in portal
ADLS_CONTAINER_BRONZE=bronze
ADLS_CONTAINER_GOLD=gold

# --- Databricks (set in cluster env vars OR Databricks secrets) ---
# Recommended: Use Databricks Secret Scope instead of plain env vars
# databricks secrets put --scope fleet-scope --key eh-connection-string
DATABRICKS_SECRET_SCOPE=fleet-scope

# --- Producer Settings ---
PRODUCER_EVENTS_PER_SECOND=50          # Target throughput (events/sec per vehicle)
PRODUCER_VEHICLE_COUNT=10              # Number of simulated vehicles
PRODUCER_ANOMALY_RATE=0.05            # 5% of events will be anomalous

# --- Alert Thresholds ---
SPEED_BREACH_MULTIPLIER=1.15          # Alert if speed > max_speed * 1.15
ENGINE_TEMP_WARNING_C=95              # Warning threshold
ENGINE_TEMP_CRITICAL_C=110            # Critical threshold
FUEL_LOW_PCT=15                       # Alert if fuel < 15%
